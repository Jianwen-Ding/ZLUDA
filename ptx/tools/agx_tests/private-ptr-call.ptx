// A pointer to the caller's local memory (generic, from cvta.local) passed to a called function that writes
// through it: the function is large and called twice, so it stays a real call on AGX. It also has local memory of
// its own. Blender Cycles' BVH traversal is such a function writing the kernel's Intersection. Run through the AIR
// route with real calls, as the driver compiles large modules:
//   ZLUDA_AIR_AGX_PIPELINE=none AGX_EXPERIMENTAL_RET=buffer-pop2 \
//   ZLUDA_AGX_LLVM_ARGS="-agx-experimental-leaf-calls -agx-call-relocations" \
//   agx_ptx_formalization_check.py --target air ... ptx/tools/agx_tests/private-ptr-call.ptx
.version 8.0
.target sm_80
.address_size 64

.visible .func fill(.param .b64 fill_p, .param .b32 fill_base)
{
    .local .align 4 .b8 tmp[32];
    .reg .pred %p<2>;
    .reg .b32 %r<8>;
    .reg .b64 %rd<8>;
    ld.param.u64 %rd1, [fill_p];
    ld.param.u32 %r1, [fill_base];
    mov.u32 %r4, %r1;
    mad.lo.s32 %r4, %r4, 3, %r1;
    xor.b32 %r4, %r4, 0;
    mad.lo.s32 %r4, %r4, 4, %r1;
    xor.b32 %r4, %r4, 2481;
    mad.lo.s32 %r4, %r4, 5, %r1;
