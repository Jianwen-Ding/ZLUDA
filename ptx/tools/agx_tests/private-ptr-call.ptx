    xor.b32 %r4, %r4, 2831;
    mad.lo.s32 %r4, %r4, 6, %r1;
    xor.b32 %r4, %r4, 1216;
    mad.lo.s32 %r4, %r4, 7, %r1;
    xor.b32 %r4, %r4, 3697;
    mad.lo.s32 %r4, %r4, 8, %r1;
    xor.b32 %r4, %r4, 2082;
    mad.lo.s32 %r4, %r4, 9, %r1;
    xor.b32 %r4, %r4, 467;
    mad.lo.s32 %r4, %r4, 3, %r1;
    xor.b32 %r4, %r4, 2948;
    mad.lo.s32 %r4, %r4, 4, %r1;
    xor.b32 %r4, %r4, 1333;
    mad.lo.s32 %r4, %r4, 5, %r1;
    xor.b32 %r4, %r4, 3814;
    mad.lo.s32 %r4, %r4, 6, %r1;
    xor.b32 %r4, %r4, 2199;
    st.u32 [%rd1+32], %r4;
    mov.u32 %r4, 0;
    mov.u64 %rd2, tmp;
    mov.u32 %r2, 0;
$L_fill:
    mul.lo.s32 %r3, %r2, 3;
    add.s32 %r5, %r3, %r1;
    add.s32 %r5, %r5, %r4;
    mul.wide.u32 %rd3, %r2, 4;
    add.s64 %rd4, %rd2, %rd3;
    st.local.u32 [%rd4], %r5;
    ld.local.u32 %r6, [%rd4];
    add.s64 %rd5, %rd1, %rd3;
    st.u32 [%rd5], %r6;
    add.s32 %r2, %r2, 1;
    setp.lt.u32 %p1, %r2, 8;
    @%p1 bra $L_fill;
    ret;
}

// out[tid] = sum of the 8 words fill wrote into the kernel's local array (twice: base tid, then tid + 100 over it)
.visible .entry k(.param .u64 k_out)
{
    .local .align 4 .b8 buf[36];
    .reg .pred %p<2>;
    .reg .b32 %r<8>;
    .reg .b64 %rd<10>;
    ld.param.u64 %rd1, [k_out];
    cvta.to.global.u64 %rd2, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u64 %rd3, buf;
    cvta.local.u64 %rd4, %rd3;
    {
    .param .b64 param0;
    st.param.b64 [param0+0], %rd4;
    .param .b32 param1;
    st.param.b32 [param1+0], %r1;
    call.uni fill, (param0, param1);
    }
    ld.local.u32 %r6, [%rd3];
    add.s32 %r7, %r1, 100;
    {
    .param .b64 param0;
    st.param.b64 [param0+0], %rd4;
    .param .b32 param1;
    st.param.b32 [param1+0], %r7;
    call.uni fill, (param0, param1);
    }
    mov.u32 %r2, 0;
    mov.u32 %r3, %r6;
$L_sum:
    mul.wide.u32 %rd5, %r2, 4;
    add.s64 %rd6, %rd3, %rd5;
    ld.local.u32 %r4, [%rd6];
    add.s32 %r3, %r3, %r4;
    add.s32 %r2, %r2, 1;
    setp.lt.u32 %p1, %r2, 8;
    @%p1 bra $L_sum;
    mul.wide.u32 %rd7, %r1, 4;
    add.s64 %rd8, %rd2, %rd7;
    st.global.u32 [%rd8], %r3;
    ret;
}

.buffer OUT .s32 [4];
.launch k <<< 1, 4 >>> (OUT);
.print OUT .s32;
.expect OUT .s32 = { 884, 893, 902, 911 };
