// lop3.b32 with each of the 256 constant tables on 128 operand triples (edges, the input tables, random);
// expected values from the definition (bit i of the table is the result for (a, b, c) = (i >> 2, i >> 1, i) & 1).
.version 8.0
.target sm_80
.address_size 64
.visible .entry k(.param .u64 pa, .param .u64 pb, .param .u64 pc, .param .u64 po)
{
  .reg .u64 %x, %y, %z, %o, %t2; .reg .u32 %t, %a, %b, %c, %r;
  ld.param.u64 %x, [pa]; ld.param.u64 %y, [pb]; ld.param.u64 %z, [pc]; ld.param.u64 %o, [po];
  mov.u32 %t, %tid.x; mul.wide.u32 %t2, %t, 4; add.u64 %x, %x, %t2; add.u64 %y, %y, %t2; add.u64 %z, %z, %t2;
  mul.wide.u32 %t2, %t, 1024; add.u64 %o, %o, %t2;
  ld.global.u32 %a, [%x]; ld.global.u32 %b, [%y]; ld.global.u32 %c, [%z];
  lop3.b32 %r, %a, %b, %c, 0x00; st.global.u32 [%o+0], %r;
  lop3.b32 %r, %a, %b, %c, 0x01; st.global.u32 [%o+4], %r;
  lop3.b32 %r, %a, %b, %c, 0x02; st.global.u32 [%o+8], %r;
