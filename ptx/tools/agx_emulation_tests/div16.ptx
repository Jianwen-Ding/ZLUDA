// div / rem of 8- and 16-bit integers (s8, u8, s16, u16): 1024 pairs each (every pair of edge values, random,
// small divisors, zero divisors: quotient all ones and remainder the dividend, as the backend defines them),
// expected from Python integers.
.version 8.0
.target sm_80
.address_size 64
.visible .entry ks8(.param .u64 ppa, .param .u64 ppb, .param .u64 ppq, .param .u64 ppr)
{
  .reg .u64 %pa, %pb, %pq, %pr, %o; .reg .u32 %t, %c, %n;
  ld.param.u64 %pa, [ppa]; ld.param.u64 %pb, [ppb]; ld.param.u64 %pq, [ppq]; ld.param.u64 %pr, [ppr];
  mov.u32 %t, %tid.x; mov.u32 %c, %ctaid.x; mov.u32 %n, %ntid.x; mad.lo.u32 %t, %c, %n, %t;
  mul.wide.u32 %o, %t, 1; add.u64 %pa, %pa, %o; add.u64 %pb, %pb, %o; add.u64 %pq, %pq, %o; add.u64 %pr, %pr, %o;
  .reg .s16 %a, %b, %q, %r;
  ld.global.s8 %a, [%pa]; ld.global.s8 %b, [%pb];
  div.s16 %q, %a, %b; rem.s16 %r, %a, %b;
  // as 8-bit values: the operands are 8-bit, so are the quotient and remainder (bar the zero divisor's)
  st.global.u8 [%pq], %q; st.global.u8 [%pr], %r;
  ret;
}
