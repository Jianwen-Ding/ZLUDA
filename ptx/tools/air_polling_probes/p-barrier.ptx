.version 8.6
.target sm_90
.address_size 64
.visible .entry k(.param .u64 po)
{
    .reg .b64 %o, %a; .reg .b32 %t, %v, %n; .reg .pred %p, %q;
    ld.param.u64 %o, [po];
    mov.u32 %t, %tid.x;
    mov.u32 %n, 0;
    setp.eq.u32 %p, %t, 0;
    @!%p bra REST;
POLL: ld.volatile.global.u32 %v, [%o];
    add.u32 %n, %n, 1;
    setp.ne.u32 %q, %v, 0;
    @%q bra DONE;
    setp.lt.u32 %q, %n, 200000;
    @%q bra POLL;
DONE: st.global.u32 [%o+4], %v;
REST: mov.u32 %v, 1;
    st.volatile.global.u32 [%o], %v;
    bar.sync 0;
    add.u64 %a, %o, 8;
    atom.add.global.u32 %v, [%a], 1;
    ret;
}
.buffer O .u32 [3];
.launch k <<< 1, 2 >>> (O);
.expect O .u32 = { 1, 1, 2 };
