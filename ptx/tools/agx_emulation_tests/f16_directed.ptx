.version 8.0
.target sm_80
.address_size 64
.visible .entry k(.param .u64 px, .param .u64 pz, .param .u64 pm, .param .u64 pp, .param .u64 pn)
{
  .reg .u64 %x, %z, %m, %p, %n, %o, %t2; .reg .u32 %t, %c, %w; .reg .f32 %f; .reg .b16 %h;
  ld.param.u64 %x, [px]; ld.param.u64 %z, [pz]; ld.param.u64 %m, [pm]; ld.param.u64 %p, [pp]; ld.param.u64 %n, [pn];
  mov.u32 %t, %tid.x; mov.u32 %c, %ctaid.x; mov.u32 %w, %ntid.x; mad.lo.u32 %t, %c, %w, %t;
  mul.wide.u32 %o, %t, 4; add.u64 %x, %x, %o; ld.global.f32 %f, [%x];
  mul.wide.u32 %t2, %t, 2; add.u64 %z, %z, %t2; add.u64 %m, %m, %t2; add.u64 %p, %p, %t2; add.u64 %n, %n, %t2;
  cvt.rz.f16.f32 %h, %f; st.global.b16 [%z], %h;
  cvt.rm.f16.f32 %h, %f; st.global.b16 [%m], %h;
  cvt.rp.f16.f32 %h, %f; st.global.b16 [%p], %h;
  cvt.rn.f16.f32 %h, %f; st.global.b16 [%n], %h;
  ret;
}
