// 256 threads: tex.2d of a 8x6 u8 texture (4 channel(s), filter 1, address 0, normalized 1),
// read as normalized floats at coordinates on texel edges, centres and weight boundaries, random and out of range.
.visible .entry k(.param .u64 pt, .param .u64 pc, .param .u64 po)
{
    .reg .b64 %t, %c, %o, %a;
    .reg .b32 %i;
    .reg .f32 %x, %y, %r0, %r1, %r2, %r3;
    ld.param.u64 %t, [pt]; ld.param.u64 %c, [pc]; ld.param.u64 %o, [po];
    mov.u32 %i, %tid.x;
    mul.wide.u32 %a, %i, 8;
    add.u64 %a, %c, %a;
    ld.global.f32 %x, [%a]; ld.global.f32 %y, [%a+4];
    tex.2d.v4.f32.f32 {%r0, %r1, %r2, %r3}, [%t, {%x, %y}];
    mul.wide.u32 %a, %i, 16;
    add.u64 %a, %o, %a;
    st.global.f32 [%a], %r0; st.global.f32 [%a+4], %r1; st.global.f32 [%a+8], %r2; st.global.f32 [%a+12], %r3;
    ret;
}

