  br label %chunks
b2:
  %x2 = and i32 %line, 3
  br label %chunks
b1:
  %x1 = and i32 %line, 1
  br label %chunks
chunks:
  %x = phi i32 [ %x3, %b3 ], [ %x2, %b2 ], [ %x1, %b1 ]
