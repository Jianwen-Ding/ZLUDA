// shf.l / shf.r .wrap / .clamp of 256 operand pairs with every shift amount 0..63 (expected from the definition:
// the 64-bit (b:a) shifted, the high word for left, the low for right; .wrap takes the amount mod 32, .clamp min(n, 32)).
.version 8.0
.target sm_80
.address_size 64
.visible .entry k(.param .u64 pa, .param .u64 pb, .param .u64 ps, .param .u64 po)
{
  .reg .u64 %x, %y, %z, %o, %t2; .reg .u32 %t, %a, %b, %s, %r<4>;
  ld.param.u64 %x, [pa]; ld.param.u64 %y, [pb]; ld.param.u64 %z, [ps]; ld.param.u64 %o, [po];
  mov.u32 %t, %tid.x; mul.wide.u32 %t2, %t, 4; add.u64 %x, %x, %t2; add.u64 %y, %y, %t2; add.u64 %z, %z, %t2;
  mul.wide.u32 %t2, %t, 16; add.u64 %o, %o, %t2;
  ld.global.u32 %a, [%x]; ld.global.u32 %b, [%y]; ld.global.u32 %s, [%z];
  shf.l.wrap.b32 %r0, %a, %b, %s; shf.l.clamp.b32 %r1, %a, %b, %s;
  shf.r.wrap.b32 %r2, %a, %b, %s; shf.r.clamp.b32 %r3, %a, %b, %s;
  st.global.v4.u32 [%o], {%r0, %r1, %r2, %r3};
  ret;
}
